# Production settings for the Meyora API container.
# In Azure Container Apps, put everything marked SECRET under "Secrets" and reference it
# from the environment variable (secretref:), never as a plain value.

APP_ENV=production                         # turns on the safety checks below and HTTPS-only cookies

# --- Database (Neon) ----------------------------------------------------------------
# The APP role URL from scripts/setup_database.py (NEON_APP_DATABASE_URL), pooled host.
DATABASE_URL=postgresql+asyncpg://meyora_app:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?ssl=require  # SECRET
DB_STATEMENT_CACHE_SIZE=0                  # required with Neon's pooled (PgBouncer) connection

# --- Secrets that must never change between deploys -----------------------------------
# Copy these from your current .env. A new ENCRYPTION_KEY makes every saved API key,
# the Google secret and Gmail tokens unreadable. A new JWT_SECRET signs everyone out.
ENCRYPTION_KEY=<32 bytes, base64>          # SECRET
JWT_SECRET=<at least 32 random characters> # SECRET

# --- Addresses ----------------------------------------------------------------------------
PUBLIC_URL=https://app.meyora.in           # the web app (Vercel)
API_PUBLIC_URL=https://api.meyora.in       # this API (Google redirect URIs point here)
CORS_ORIGINS=["https://app.meyora.in"]

# --- AI and web search: shared keys (optional here; can also be set on the Platform page) ---
GROQ_API_KEY=                              # SECRET
TAVILY_API_KEY=                            # SECRET
GEMINI_API_KEY=                            # SECRET
OPENROUTER_API_KEY=                        # SECRET
AI_DAILY_TOKEN_QUOTA=150000

# --- Google sign-in & Gmail (optional here; the Platform page overrides these) ----------------
GOOGLE_AUTH_ENABLED=false
GMAIL_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                      # SECRET

# --- Behaviour ------------------------------------------------------------------------------
EMBEDDING_WARMUP=true                      # load the AI model in the background right after start
JOBS_IDLE_MAX_SECONDS=600                  # idle worker sleeps this long, letting Neon suspend
# The image already sets EMBEDDING_CACHE_DIR=/app/models (model baked in).

# Migrations are NOT run by the container by default (the app role can't change tables).
# Run them from your machine with the owner role:  python -m scripts.setup_database
# MIGRATE_ON_START=true
# ALEMBIC_DATABASE_URL=<owner URL>          # SECRET, only if MIGRATE_ON_START=true
