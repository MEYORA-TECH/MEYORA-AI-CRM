# Vercel → Project → Settings → Environment Variables (Production).
#
# Leave VITE_API_URL unset when vercel.json forwards /api to the backend (the default setup:
# the app and its API share one address, e.g. https://nila.meyora.in).
# Set it only if the API has its own domain, which must be a sibling of the web app's
# (e.g. app.meyora.in / api.meyora.in) because the sign-in cookie is SameSite=Strict.
# VITE_API_URL=https://api.meyora.in
