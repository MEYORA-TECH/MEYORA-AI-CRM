# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose defaults) ---
POSTGRES_PASSWORD=change-me-superuser
MEYORA_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+asyncpg://meyora:change-me-app@localhost:5432/meyora
TEST_DATABASE_URL=postgresql+asyncpg://meyora:change-me-app@localhost:5432/meyora_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ---
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
