# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose defaults) ---
POSTGRES_PASSWORD=change-me-superuser
MEYORA_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+asyncpg://meyora:change-me-app@localhost:5432/meyora
TEST_DATABASE_URL=postgresql+asyncpg://meyora:change-me-app@localhost:5432/meyora_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ---
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false

# --- AI (all optional; the assistant is disabled until one trusted provider has a key) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=
AI_DAILY_TOKEN_QUOTA=150000

# --- Google sign-in & Gmail (optional toggles) ---
# Create an OAuth client (Web application) in Google Cloud Console. Authorised redirect URIs:
#   {PUBLIC_URL}/api/auth/google/callback
#   {PUBLIC_URL}/api/integrations/gmail/callback
GOOGLE_AUTH_ENABLED=false
GMAIL_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:5173
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# --- Web research (optional) ---
# Free key: https://app.tavily.com (about 1,000 searches a month)
TAVILY_API_KEY=
# Optional: public-only model for research briefs. Its free tier may train on prompts,
# so Meyora never sends it CRM data. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hosted database (Neon). Direct URL for migrations and imports, pooled for the app.
# `python -m scripts.setup_database` (from backend/) migrates and creates NEON_APP_DATABASE_URL.
# In production set DATABASE_URL to NEON_APP_DATABASE_URL and DB_STATEMENT_CACHE_SIZE=0 (PgBouncer).
NEON_DATABASE_URL=postgresql+asyncpg://neondb_owner:<password>@<endpoint>.neon.tech/neondb?ssl=require
NEON_DATABASE_URL_POOLED=postgresql+asyncpg://neondb_owner:<password>@<endpoint>-pooler.neon.tech/neondb?ssl=require
NEON_APP_DATABASE_URL=

# Platform admins run the whole installation (Platform page: Google & Gmail, shared keys,
# every workspace's usage). Grant from the server only:
#   cd backend && python -m scripts.platform_admin grant you@example.com
# Values saved on the Platform page override GOOGLE_* and the *_API_KEY settings above.
